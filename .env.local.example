# These are auto-filled by Vercel when you add the integrations below.
# You generally do NOT need to set these by hand if deploying on Vercel.

# Shared password for the whole site (leave blank/unset to disable the gate)
APP_PASSWORD=

# From the "Blob" storage integration (Vercel dashboard > Storage > Create > Blob)
BLOB_READ_WRITE_TOKEN=

# From the "Upstash Redis" Marketplace integration (Vercel dashboard > Storage > Create Database > Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
